#!/usr/bin/env bash
# zelland-ask-notify — notify zelland when Claude Code uses AskUserQuestion
#
# Designed as a PostToolUse hook for AskUserQuestion.
#
# stdin: {"tool_name":"AskUserQuestion","tool_input":{"questions":[{"question":"..."}]},...}
#
# Install: copy to ~/bin/ or ~/.local/bin/ and chmod +x
# Hook config (Claude Code ~/.claude/settings.json):
#   "hooks": {
#     "PostToolUse": [{
#       "matcher": "AskUserQuestion",
#       "hooks": [{ "type": "command", "command": "zelland-ask-notify" }]
#     }]
#   }

INPUT=$(cat)
QUESTION=$(printf '%s' "$INPUT" | jq -r '.tool_input.questions[0].question // "Claude needs input"')

zn notify "Claude needs your answer" "$QUESTION" \
    --source claude_code \
    --question "$QUESTION"

# Gemini CLI requires valid JSON on stdout (exit 0 = success)
printf '{}'
