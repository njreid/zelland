#!/usr/bin/env bash
# zelland-agent-notify — fire a zelland notification from an agent hook
#
# Usage: zelland-agent-notify <source>
#   source: user | claude_code | gemini_cli | zellij_plugin (default: user)
#
# stdin: JSON with title + message/body fields (e.g. Claude Code stop hook payload)
#
# Install: copy to ~/bin/ or ~/.local/bin/ and chmod +x
# Hook config (Claude Code ~/.claude/settings.json):
#   "hooks": { "Stop": [{ "type": "command", "command": "zelland-agent-notify claude_code" }] }

SOURCE="${1:-user}"
INPUT=$(cat)
TITLE=$(printf '%s' "$INPUT" | jq -r '.title // "Agent notification"')
BODY=$(printf '%s'  "$INPUT" | jq -r '.message // .body // ""')
QUESTION=$(printf '%s' "$INPUT" | jq -r '.question // ""')

if [ -n "$QUESTION" ]; then
    zn notify "$TITLE" "$BODY" --source "$SOURCE" --question "$QUESTION"
else
    zn notify "$TITLE" "$BODY" --source "$SOURCE"
fi
