{
  "$schema": "../gen/schemas/capability.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "shell:default",
    "process:default",
    "notification:default",
    "store:default",
    "haptics:default"
  ]
}